# ═══════════════════════════════════════════════════════════════════════════
#  STORE BRANDING (optional)
# ═══════════════════════════════════════════════════════════════════════════
#  Leave this whole block EMPTY for the Philly Phone Repair deployment — every
#  value falls back to Philly's real details, so the live site is unaffected.
#
#  To stand up a second store, copy `.env.prime.example` instead, which
#  documents every BRAND_* / VITE_BRAND_* variable in full.
#
#  Each value has a browser spelling (VITE_BRAND_*) and a server spelling
#  (BRAND_*); set both so emails and pages agree.
# ═══════════════════════════════════════════════════════════════════════════
# BRAND_NAME=                     # store name; also split into the wordmark
# VITE_BRAND_NAME=
# BRAND_TAGLINE=                  # small uppercase line under the wordmark
# BRAND_REGION=                   # footer phrase, e.g. "Center City Philadelphia"
# BRAND_CITY_LABEL=               # short city name for headlines, e.g. "Philly"
# BRAND_STREET=
# BRAND_CITY=                     # "Philadelphia, PA 19107"
# BRAND_PHONE=
# BRAND_EMAIL=
# BRAND_WHATSAPP=                 # digits, country code first
# BRAND_HOURS=Monday-Thursday|9 AM-7 PM;Friday-Saturday|10 AM-10 PM;Sunday|11 AM-9 PM
# BRAND_SITE_URL=                 # canonical domain
# BRAND_LOGO_TYPE=image           # "image" (default) or "svg" placeholder mark
# BRAND_LOGO_ICON=/logo-icon.png
# BRAND_LOGO_FULL=/logo-full.png
# BRAND_PRIMARY=#7F1D1D           # palette; see contracts/brand-colors.json
# BRAND_SECONDARY=#F3D5D8
# BRAND_SURFACE=#FFFDF7
# BRAND_INK=#2B1A18
# BRAND_ACCENT=#7F1D1D

# ── Backend (Firebase) ──────────────────────────────────────────
# Firebase project id (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=
# Service account JSON values from Firebase Console > Project Settings > Service accounts
# LEGACY: only needed if you are still using a long-lived service-account key.
# Prefer keyless Workload Identity Federation below — many Google Cloud orgs
# forbid key creation, and Google recommends avoiding long-lived keys.
FIREBASE_CLIENT_EMAIL=            # e.g. firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=             # e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional: mark a Firebase UID as admin on first sign-in
FIREBASE_ADMIN_UID=

# ── Keyless Google Cloud auth (PREFERRED) ───────────────────────
# Vercel OIDC token -> Google Workload Identity Federation -> short-lived access
# token. Set ALL FOUR to enable; leave all blank to fall back to the legacy
# service-account path or Application Default Credentials. None are secrets.
# Requires the Vercel dashboard toggle:
#   Project > Settings > General > "Enable access to System Environment Variables"
GCP_WORKLOAD_IDENTITY_PROJECT_NUMBER=   # GCP project NUMBER (not id)
GCP_WORKLOAD_IDENTITY_POOL_ID=          # e.g. vercel-pool
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=      # e.g. vercel
GCP_SERVICE_ACCOUNT_EMAIL=              # e.g. firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com

# ── Frontend (exposed to browser via Vite) ──────────────────────
# From Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=        # e.g. <project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
# Not used. Product images are stored in Firestore, not Cloud Storage, because
# Cloud Storage needs the Blaze plan before a bucket can exist. Kept only so
# existing deployments with this variable set keep building unchanged.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Customer email (optional — SendGrid preferred, else SMTP) ───
# Used for booking confirmations and repair-status updates. Without these the
# messages are still recorded in the CRM notification history, but not sent.
SENDGRID_API_KEY=
SENDGRID_FROM=                    # must be a verified SendGrid sender
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STAFF_EMAIL=                      # where new-booking alerts are sent

# ── Customer SMS (optional — Twilio) ────────────────────────────
# Real text messages for bookings and status changes ("repair ready" etc).
# Leave blank to disable; SMS is then only logged in the CRM history.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=               # your Twilio number in E.164, e.g. +12155550123

# ── Online shop payments (optional — Stripe Checkout) ──────────
# With a secret key set, the cart offers "Pay online by card" as well as
# pay-in-store. Leave blank and the checkout still works: orders are recorded
# and staff collect payment at pickup.
STRIPE_SECRET_KEY=                # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=            # whsec_… — add /api/stripe/webhook in Stripe
# Absolute public URL used for Stripe success/cancel redirects and for links in
# order and receipt emails. Defaults to the brand site URL.
PUBLIC_SITE_URL=                  # e.g. https://philly-wireless.vercel.app
# In Stripe: Developers > Webhooks > Add endpoint
#   URL:    https://<your-domain>/api/stripe/webhook
#   Events: checkout.session.completed
# The webhook is what marks an order paid if the customer closes the tab
# before returning from Stripe.
#
# Sales tax applied to online orders, as a percent (0–25). Defaults to 0 so
# adding the shop does not silently change prices. Philadelphia is 8 — confirm
# the correct rate for your business with an accountant before enabling it.
ORDER_TAX_PERCENT=

# How long an unpaid card order holds its stock, in minutes (30–1440).
# Defaults to 60. Stripe sessions expire at the same time; the stock is
# released only after the session plus a 15-minute grace period.
ORDER_RESERVATION_MINUTES=

# ── AI assistant (optional — OpenAI-compatible) ────────────────
# Default provider is DeepSeek. To use a local/self-hosted model, set
# AI_BASE_URL to an OpenAI-compatible server (include /v1 if required) and
# AI_MODEL to its model name. The server must support tool calls, because the
# assistants query live prices/slots and prepared admin actions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash       # optional; defaults to deepseek-flash
AI_BASE_URL=                        # e.g. http://127.0.0.1:11434/v1
AI_API_KEY=                         # optional; falls back to DEEPSEEK_API_KEY
AI_MODEL=                           # exact id from /v1/models (e.g. lfm3-omni-2b:2)
AI_TIMEOUT_MS=60000                 # local models can be slow; Vercel caps this
STORE_TIMEZONE=America/New_York     # used for hours and today's cutoff

# ── Scheduled reconciliation (optional — Vercel Cron) ──────────
# Protects the daily /api/cron/reconcile-orders job. Vercel sends this value
# automatically as a Bearer token when the variable exists. Without it the
# endpoint is disabled (the admin "Release expired holds" button still works).
CRON_SECRET=

# ── Legacy (no longer required) ─────────────────────────────────
# APP_ID=
# APP_SECRET=
# DATABASE_URL=
# KIMI_AUTH_URL=
# KIMI_OPEN_URL=
# OWNER_UNION_ID=