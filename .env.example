# ── Backend (Firebase) ──────────────────────────────────────────
# Firebase project id (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=
# Service account JSON values from Firebase Console > Project Settings > Service accounts
FIREBASE_CLIENT_EMAIL=            # e.g. firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=             # e.g. -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional: mark a Firebase UID as admin on first sign-in
FIREBASE_ADMIN_UID=

# ── Frontend (exposed to browser via Vite) ──────────────────────
# From Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=        # e.g. <project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=     # e.g. <project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Email (optional ── SMTP or SendGrid) ────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=
STAFF_EMAIL=

# ── Legacy (no longer required) ─────────────────────────────────
# APP_ID=
# APP_SECRET=
# DATABASE_URL=
# KIMI_AUTH_URL=
# KIMI_OPEN_URL=
# OWNER_UNION_ID=