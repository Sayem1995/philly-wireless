# ═══════════════════════════════════════════════════════════════════════════
#  PRIME WIRELESS — second storefront profile
# ═══════════════════════════════════════════════════════════════════════════
#
#  This is NOT a separate codebase. The same repo and the same build serve both
#  Philly Phone Repair and Prime Wireless; the store is chosen entirely by
#  environment variables.
#
#  To stand up Prime Wireless:
#
#    1. Create a SECOND Vercel project from this same GitHub repo.
#    2. Paste the variables below into that project's
#       Settings → Environment Variables (Production + Preview).
#    3. Create a NEW Firebase project (do NOT reuse philly-repair) and fill in
#       the VITE_FIREBASE_* block and the server credentials block.
#    4. Deploy. The site renders as Prime Wireless with its own database.
#
#  Leave the Philly project untouched: it has none of these variables set, so
#  it falls back to the built-in Philly Phone Repair defaults.
#
#  ⚠️  VALUES MARKED "PLACEHOLDER" ARE FAKE. Phone number, email address and
#      the public domain were not known at setup time and MUST be replaced
#      before this store goes live — the phone number is printed into customer
#      emails and SMS messages, and the domain is used in the schema.org block
#      and in receipt links.
# ═══════════════════════════════════════════════════════════════════════════

# ── Brand identity ─────────────────────────────────────────────────────────
BRAND_NAME=Prime Wireless
VITE_BRAND_NAME=Prime Wireless

# The wordmark renders as "Prime" in ink + "Wireless" in the brand colour.
# Both are derived from BRAND_NAME automatically; set these only to override.
# BRAND_WORDMARK_PRIMARY=Prime
# BRAND_WORDMARK_ACCENT=Wireless

BRAND_TAGLINE=19th Street · Philadelphia
VITE_BRAND_TAGLINE=19th Street · Philadelphia

BRAND_REGION=Center City Philadelphia
VITE_BRAND_REGION=Center City Philadelphia

# Short city name used in headlines ("Philly trusts us with their phones.").
# Defaults to "Philly"; set it so the copy reads correctly for this store.
BRAND_CITY_LABEL=Philadelphia
VITE_BRAND_CITY_LABEL=Philadelphia

BRAND_DESCRIPTION=Same-day phone, tablet, laptop and game console repair at 19th and Chestnut in Philadelphia.
VITE_BRAND_DESCRIPTION=Same-day phone, tablet, laptop and game console repair at 19th and Chestnut in Philadelphia.

# Opening paragraph of the About page.
BRAND_STORY=We opened with one bench, one soldering iron, and a simple promise: fix it fast, fix it right, and tell people the truth about what it costs.

# ── Address & contact — REPLACE THE PLACEHOLDERS ───────────────────────────
BRAND_STREET=25 South 19th Street
VITE_BRAND_STREET=25 South 19th Street

BRAND_CITY=Philadelphia, PA 19103
VITE_BRAND_CITY=Philadelphia, PA 19103

# PLACEHOLDER — replace with the real store number.
BRAND_PHONE=(215) 555-0100
VITE_BRAND_PHONE=(215) 555-0100

# PLACEHOLDER — replace with the real inbox. Used as the "from"/reply-to
# address for customer email and as the fallback recipient for staff alerts.
BRAND_EMAIL=hello@primewireless.example
VITE_BRAND_EMAIL=hello@primewireless.example

# WhatsApp click-to-chat. Digits only, country code first, no punctuation.
# PLACEHOLDER — defaults to BRAND_PHONE when unset.
BRAND_WHATSAPP=12155550100
VITE_BRAND_WHATSAPP=12155550100

# ── Opening hours ──────────────────────────────────────────────────────────
# Format: "Days|Times" per row, rows separated by ";".
# Philly's default is Mon-Fri 9-7, Sat 10-6, Sun 12-5 — these override it.
BRAND_HOURS=Monday-Saturday|10 AM-10 PM;Sunday|11 AM-9 PM
VITE_BRAND_HOURS=Monday-Saturday|10 AM-10 PM;Sunday|11 AM-9 PM

# ── Domain — REPLACE THE PLACEHOLDER ───────────────────────────────────────
# Used for the canonical link, the schema.org block and receipt links in email.
# PLACEHOLDER — set this to the real production domain once it exists.
BRAND_SITE_URL=https://prime-wireless.vercel.app
VITE_BRAND_SITE_URL=https://prime-wireless.vercel.app
PUBLIC_SITE_URL=https://prime-wireless.vercel.app

# ── Logo ───────────────────────────────────────────────────────────────────
# "svg" renders the built-in inline placeholder mark (navy disc, electric-blue
# bolt) in the brand colours. Switch to "image" and set the two paths once real
# artwork exists.
BRAND_LOGO_TYPE=svg
VITE_BRAND_LOGO_TYPE=svg
# BRAND_LOGO_TYPE=image
# VITE_BRAND_LOGO_TYPE=image
# BRAND_LOGO_ICON=/prime-logo-icon.png
# VITE_BRAND_LOGO_ICON=/prime-logo-icon.png
# BRAND_LOGO_FULL=/prime-logo-full.png
# VITE_BRAND_LOGO_FULL=/prime-logo-full.png

# ── Theme: Navy + White + Electric Blue ────────────────────────────────────
# Plain hex values. The build converts them to RGB channel triplets for the
# stylesheet and uses them as literal hex in the email templates.
# primary   = navy          (headers, buttons, links, email accents)
# secondary = soft steel    (borders, tints, hover washes)
# surface   = white         (page background)
# ink       = near-navy     (body text)
BRAND_PRIMARY=#0B2545
VITE_BRAND_PRIMARY=#0B2545

BRAND_PRIMARY_DARK=#071A33
VITE_BRAND_PRIMARY_DARK=#071A33

BRAND_PRIMARY_LIGHT=#13315C
VITE_BRAND_PRIMARY_LIGHT=#13315C

BRAND_SECONDARY=#DCE7F5
VITE_BRAND_SECONDARY=#DCE7F5

BRAND_SECONDARY_DARK=#B9CDE8
VITE_BRAND_SECONDARY_DARK=#B9CDE8

BRAND_SECONDARY_LIGHT=#F2F7FD
VITE_BRAND_SECONDARY_LIGHT=#F2F7FD

BRAND_SURFACE=#FFFFFF
VITE_BRAND_SURFACE=#FFFFFF

BRAND_INK=#0A1A2F
VITE_BRAND_INK=#0A1A2F

# Electric blue, available for accents such as icons and the logo bolt.
BRAND_ACCENT=#1E90FF
VITE_BRAND_ACCENT=#1E90FF

# ═══════════════════════════════════════════════════════════════════════════
#  FIREBASE — the "another database" part
# ═══════════════════════════════════════════════════════════════════════════
#  Prime Wireless needs its OWN Firebase project, so its bookings, customers,
#  inventory and staff accounts are completely separate from Philly's.
#
#  Steps:
#    1. https://console.firebase.google.com → Add project (e.g. "prime-wireless")
#    2. Build → Firestore Database → Create database
#    3. Build → Authentication → Sign-in method → enable Email/Password
#    4. Project settings → Your apps → Web app → copy the config into
#       VITE_FIREBASE_* below.
#    5. Project settings → Service accounts → note the admin service account.
#    6. Deploy the security rules:  npm run deploy:rules
#       (after pointing .firebaserc at the new project id)
#    7. Seed the catalog:           npm run db:seed
#
#  Prefer the keyless Workload Identity Federation block below over a
#  long-lived service-account private key — see README.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase web config (browser) ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=          # e.g. prime-wireless.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=           # e.g. prime-wireless
VITE_FIREBASE_STORAGE_BUCKET=       # e.g. prime-wireless.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Server-side project id ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=                # e.g. prime-wireless
FIREBASE_ADMIN_UID=                 # first sign-in with this UID becomes admin

# ── Keyless Google Cloud auth (PREFERRED) ──────────────────────────────────
# Create a Workload Identity Pool + OIDC provider for THIS Vercel project,
# then bind roles/iam.workloadIdentityUser to
#   principalSet://iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/attribute.sub/<owner>:<team-slug>:project:prime-wireless:environment:production
# Also enable: Vercel → Settings → General → "Enable access to System Environment Variables".
GCP_WORKLOAD_IDENTITY_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=

# ── Legacy service-account credentials (only if WIF is unavailable) ────────
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Customer email ─────────────────────────────────────────────────────────
# Brevo over HTTPS is the most reliable option on serverless. Without any
# provider the messages are still recorded in the CRM, just not delivered.
BREVO_API_KEY=
BREVO_FROM=                         # must be a verified Brevo sender
SENDGRID_API_KEY=
SENDGRID_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STAFF_EMAIL=                        # PLACEHOLDER: where new-booking alerts go

# ── Customer SMS (Twilio, optional) ────────────────────────────────────────
# Give Prime Wireless its OWN Twilio number so replies reach the right store.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
