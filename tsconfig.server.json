{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    // The palette lives in JSON so `tailwind.config.js` and `vite.config.ts` can
    // read it too, and the colour tests import it directly.
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "contracts", "scripts", "api"],
  "exclude": [
    "node_modules",
    "scripts/seed.js",
    "scripts/brand-check.ts"
  ]
}