rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog data — read-only for everyone
    match /repairPrices/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /blogPosts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Customer-facing submissions — create allowed, read/write via backend only
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Admin/CRM data — backend (Firebase Functions with admin SDK) only.
    // Client SDK never reads these collections directly; all access is
    // through /api/trpc which validates the Firebase ID token server-side.
    match /users/{id} {
      allow read, write: if false;
    }
    match /customers/{id} {
      allow read, write: if false;
    }
    match /customerNotes/{id} {
      allow read, write: if false;
    }
    match /notifications/{id} {
      allow read, write: if false;
    }
    match /parts/{id} {
      allow read, write: if false;
    }
    match /__counters/{id} {
      allow read, write: if false;
    }
  }
}